<% if(success && success.length) { %>
    <div class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[100] animate-fade-in-down w-[90%] max-w-md">
        <div class="bg-white border-l-4 border-green-500 rounded-r-xl shadow-lg p-4 flex items-start gap-3">
            <div class="flex-shrink-0 text-green-500">
                <i class="fas fa-check-circle text-xl"></i>
            </div>
            <div class="flex-1">
                <p class="text-sm font-medium text-gray-900">
                    <%= success %>
                </p>
            </div>
            <button onclick="this.parentElement.parentElement.remove()"
                class="text-gray-400 hover:text-gray-600 transition-colors">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    <% } %>

        <% if(error && error.length) { %>
            <div class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[100] animate-fade-in-down w-[90%] max-w-md">
                <div class="bg-white border-l-4 border-red-500 rounded-r-xl shadow-lg p-4 flex items-start gap-3">
                    <div class="flex-shrink-0 text-red-500">
                        <i class="fas fa-exclamation-circle text-xl"></i>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm font-medium text-gray-900">
                            <%= error %>
                        </p>
                    </div>
                    <button onclick="this.parentElement.parentElement.remove()"
                        class="text-gray-400 hover:text-gray-600 transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <% } %>
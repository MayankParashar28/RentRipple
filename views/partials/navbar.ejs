<!-- Premium Light Glass Navbar -->
<nav class="sticky top-0 z-50 w-full">
    <!-- Full Width Container -->
    <div class="w-full bg-white/80 backdrop-blur-md border-b border-gray-200 shadow-sm transition-all duration-500">
        <div class="w-full">
            <div class="flex justify-between items-center h-20 px-4 lg:px-8">

                <!-- LEFT: Brand / Logo Area -->
                <div class="flex-shrink-0 flex items-center h-full">
                    <a href="/" class="flex items-center gap-2 group transition-all duration-300">
                        <div class="relative">
                            <i
                                class="fas fa-paper-plane text-3xl text-[#FF385C] transform group-hover:-translate-y-1 group-hover:rotate-12 transition-transform duration-300 drop-shadow-sm"></i>
                            <div
                                class="absolute -bottom-1 -right-1 w-2 h-2 bg-black rounded-full animate-ping opacity-75">
                            </div>
                        </div>
                        <span
                            class="text-2xl font-[800] tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-[#FF385C] to-[#E00B41] group-hover:from-black group-hover:to-gray-800 transition-all font-[Outfit]">
                            RentRipple
                        </span>
                    </a>
                </div>

                <!-- CENTER: Premium Search Bar -->
                <div class="hidden md:flex flex-1 justify-center items-center h-full px-6">
                    <div class="group relative w-full max-w-xl">
                        <!-- Search Container -->
                        <form action="/" method="GET" class="relative">
                            <div
                                class="flex items-center w-full h-12 bg-white/80 border border-gray-200 rounded-full shadow-sm hover:shadow-md transition-all duration-300 px-3 gap-3 hover:border-gray-300 focus-within:ring-2 focus-within:ring-gray-100 focus-within:border-gray-300">

                                <!-- Search Icon -->
                                <i
                                    class="fas fa-search text-gray-400 group-hover:text-[#FF385C] transition-colors duration-300"></i>

                                <!-- Input -->
                                <input type="text" name="search" id="search-input" autocomplete="off"
                                    value="<%= (typeof search !== 'undefined') ? search : '' %>"
                                    class="flex-1 bg-transparent border-none focus:ring-0 focus:outline-none text-sm font-medium text-gray-700 placeholder-gray-400 leading-normal px-2 h-full rounded-full"
                                    placeholder="Search destinations...">
                            </div>
                            <!-- Autocomplete Dropdown -->
                            <div id="search-suggestions"
                                class="absolute top-14 left-0 right-0 bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden z-[100] hidden">
                            </div>
                        </form>
                    </div>
                </div>

                <!-- RIGHT: Actions -->
                <div class="hidden md:flex items-center h-full gap-4 flex-none justify-end">

                    <div class="flex items-center gap-1 h-10">
                        <a href="/listings"
                            class="h-full flex items-center px-4 text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100/80 hover:shadow-sm rounded-full transition-all duration-300 text-decoration-none border border-transparent hover:border-gray-200/50 focus:outline-none focus:ring-2 focus:ring-gray-200">
                            Explore
                        </a>
                        <a href="/listings/new"
                            class="h-full flex items-center px-4 text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100/80 hover:shadow-sm rounded-full transition-all duration-300 text-decoration-none border border-transparent hover:border-gray-200/50 focus:outline-none focus:ring-2 focus:ring-gray-200">
                            Rent home
                        </a>
                    </div>

                    <!-- User Menu -->
                    <div class="relative h-12 flex items-center" id="user-menu-btn">
                        <button
                            class="flex items-center gap-2.5 bg-white border border-gray-200 hover:border-gray-300 hover:shadow-lg rounded-full p-1.5 pl-3 transition-all duration-300 group hover:-translate-y-0.5 h-10">
                            <i
                                class="fas fa-bars text-gray-400 group-hover:text-gray-600 transition-colors text-sm"></i>
                            <div
                                class="h-8 w-8 rounded-full bg-gradient-to-tr from-gray-800 to-gray-900 text-white flex items-center justify-center shadow-lg shadow-gray-200 overflow-hidden ring-2 ring-white">
                                <% if(curruser) { %>
                                    <span class="text-xs font-bold text-white/90">
                                        <%= curruser.username[0].toUpperCase() %>
                                    </span>
                                    <% } else { %>
                                        <i class="fas fa-user text-xs"></i>
                                        <% } %>
                            </div>
                        </button>
                    </div>

                </div>

                <!-- Mobile Menu Button -->
                <div class="md:hidden flex items-center ">
                    <button id="mobile-menu-btn"
                        class="p-2.5 bg-white rounded-xl shadow-sm border border-gray-100 text-gray-600 active:scale-95 transition-all">
                        <i class="fas fa-bars text-lg"></i>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Dropdown Menu -->
    <div id="user-dropdown"
        class="hidden absolute top-24 right-0 w-64 rounded-2xl bg-white/80 backdrop-blur-2xl border border-white/40 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.1)] overflow-hidden z-[60] transform origin-top-right transition-all duration-300 opacity-0 scale-95 ring-1 ring-black/5 m-2">
        <% if(!curruser) { %>
            <div class="p-2">
                <a href="/login"
                    class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-gray-700 hover:bg-white/80 hover:shadow-sm rounded-xl transition-all text-decoration-none">
                    Log in
                </a>
                <a href="/signup"
                    class="flex items-center gap-3 px-4 py-3 text-sm font-medium text-gray-700 hover:bg-white/80 hover:shadow-sm rounded-xl transition-all text-decoration-none">
                    Sign up
                </a>
            </div>
            <% } else { %>
                <div class="p-2 border-b border-gray-100/50">
                    <span class="px-4 py-1 text-[10px] uppercase font-bold text-gray-400 tracking-wider">Account</span>
                    <a href="#"
                        class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-white/80 rounded-xl transition-all text-decoration-none">Messages</a>
                    <a href="#"
                        class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-white/80 rounded-xl transition-all text-decoration-none">Trips</a>
                    <a href="#"
                        class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-white/80 rounded-xl transition-all text-decoration-none">Wishlists</a>
                </div>
                <div class="p-2">
                    <a href="/logout"
                        class="block px-4 py-2.5 text-sm font-medium text-red-500 hover:bg-red-50 rounded-xl transition-all text-decoration-none">Log
                        out</a>
                </div>
                <% } %>
    </div>

    <!-- Mobile Overlay -->
    <div id="mobile-menu"
        class="hidden absolute top-24 left-2 right-2 bg-white/95 backdrop-blur-2xl border border-white/20 rounded-3xl shadow-2xl z-50 p-4 md:hidden ring-1 ring-black/5">
        <div class="flex flex-col gap-1">
            <a href="/listings"
                class="flex items-center gap-4 px-5 py-4 text-gray-800 hover:bg-gray-50 rounded-2xl transition-all text-decoration-none font-medium">
                <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-500"><i
                        class="fas fa-compass text-sm"></i></div>
                Explore
            </a>
            <a href="/listings/new"
                class="flex items-center gap-4 px-5 py-4 text-gray-800 hover:bg-gray-50 rounded-2xl transition-all text-decoration-none font-medium">
                <div class="w-8 h-8 rounded-full bg-pink-50 flex items-center justify-center text-[#FF385C]"><i
                        class="fas fa-home text-sm"></i></div>
                Rent home
            </a>
            <div class="h-px bg-gray-100 my-2 mx-4"></div>
            <% if(!curruser) { %>
                <a href="/login"
                    class="flex items-center gap-3 px-5 py-3 text-gray-700 hover:bg-gray-50 rounded-2xl transition-all text-decoration-none font-medium text-sm">Log
                    in</a>
                <a href="/signup"
                    class="flex items-center gap-3 px-5 py-3 text-gray-700 hover:bg-gray-50 rounded-2xl transition-all text-decoration-none font-medium text-sm">Sign
                    up</a>
                <% } else { %>
                    <a href="/logout"
                        class="flex items-center gap-3 px-5 py-3 text-red-500 hover:bg-red-50 rounded-2xl transition-all text-decoration-none font-medium">
                        <i class="fas fa-sign-out-alt w-5 text-center"></i> Log out
                    </a>
                    <% } %>
        </div>
    </div>

    <script>
        const menuBtn = document.getElementById('user-menu-btn');
        const dropdown = document.getElementById('user-dropdown');
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        function toggleDropdown() {
            if (dropdown.classList.contains('hidden')) {
                dropdown.classList.remove('hidden');
                setTimeout(() => {
                    dropdown.classList.remove('opacity-0', 'scale-95');
                    dropdown.classList.add('opacity-100', 'scale-100');
                }, 10);
            } else {
                dropdown.classList.remove('opacity-100', 'scale-100');
                dropdown.classList.add('opacity-0', 'scale-95');
                setTimeout(() => {
                    dropdown.classList.add('hidden');
                }, 200);
            }
        }

        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleDropdown();
        });

        mobileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            mobileMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', () => {
            if (!dropdown.classList.contains('hidden')) {
                toggleDropdown();
            }
            if (!mobileMenu.classList.contains('hidden')) {
                mobileMenu.classList.add('hidden');
            }
        });

        dropdown.addEventListener('click', (e) => e.stopPropagation());
        mobileMenu.addEventListener('click', (e) => e.stopPropagation());

        // Search Autocomplete Logic
        const searchInput = document.getElementById('search-input');
        const suggestionsBox = document.getElementById('search-suggestions');

        if (searchInput) {
            let debounceTimeout;
            searchInput.addEventListener('input', (e) => {
                clearTimeout(debounceTimeout);
                const q = e.target.value;

                if (q.length < 2) {
                    suggestionsBox.classList.add('hidden');
                    return;
                }

                debounceTimeout = setTimeout(async () => {
                    try {
                        const res = await fetch(`/listings/search/suggestions?q=${q}`);
                        const data = await res.json();

                        if (data.length > 0) {
                            suggestionsBox.innerHTML = data.map(item => `
                                <div class="px-4 py-3 hover:bg-gray-50 cursor-pointer flex items-center gap-3 group border-b border-gray-50 last:border-none" 
                                     onclick="window.location.href='/listings?search=${encodeURIComponent(item)}'">
                                    <i class="fas fa-search text-gray-400 group-hover:text-[#FF385C]"></i>
                                    <span class="text-sm font-medium text-gray-700">${item}</span>
                                </div>
                            `).join('');
                            suggestionsBox.classList.remove('hidden');
                        } else {
                            suggestionsBox.classList.add('hidden');
                        }
                    } catch (err) {
                        console.error("Autocomplete error:", err);
                    }
                }, 300);
            });

            document.addEventListener('click', (e) => {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    suggestionsBox.classList.add('hidden');
                }
            });
        }
    </script>
</nav>
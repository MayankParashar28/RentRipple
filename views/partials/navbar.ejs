<!-- Airbnb Navbar (Centered Search) -->
<nav class="navbar-airbnb">
    <div class="listings-container w-full h-full">
        <!-- Flex Container: Logo (Left), Search (Center), Menus (Right) -->
        <div class="flex justify-between items-center h-full">

            <!-- LEFT: Logo & Company Name -->
            <div class="flex-shrink-0 flex items-center flex-none">
                <a href="/" class="flex items-center gap-2 text-decoration-none">
                    <i class="fab fa-airbnb text-3xl" style="color: var(--primary-color);"></i>
                    <span class="font-bold text-xl tracking-tight hidden lg:block" style="color: var(--primary-color);">
                        rentripple
                    </span>
                </a>
            </div>

            <!-- CENTER: Search Bar Only -->
            <div class="hidden md:flex flex-1 justify-center px-8">
                <div
                    class="flex items-center bg-white border rounded-full shadow-sm hover:shadow-md transition cursor-pointer py-2.5 px-6 gap-4 border-gray-300">
                    <span class="text-sm font-medium border-r pr-4 text-gray-900">Anywhere</span>
                    <span class="text-sm font-medium border-r pr-4 text-gray-900">Any week</span>
                    <span class="text-sm text-gray-500 pl-2">Add guests</span>
                    <div class="bg-[#FF385C] p-2 rounded-full text-white">
                        <i class="fas fa-search text-xs"></i>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Links & Profile -->
            <div class="hidden md:flex items-center gap-4 flex-none justify-end">

                <!-- Explore Link -->
                <a href="/listings"
                    class="text-sm font-semibold text-gray-800 hover:bg-gray-100 px-3 py-2 rounded-full transition text-decoration-none">
                    Explore
                </a>

                <!-- Rent Home Link -->
                <a href="/listings/new"
                    class="text-sm font-semibold text-gray-800 hover:bg-gray-100 px-3 py-2 rounded-full transition text-decoration-none">
                    Rent home
                </a>

                <!-- Globe Icon -->
                <button class="p-2 hover:bg-gray-100 rounded-full transition">
                    <i class="fas fa-globe text-gray-900"></i>
                </button>

                <!-- Profile Button -->
                <div class="flex items-center gap-3 border border-gray-300 rounded-full p-1 pl-3 hover:shadow-md transition cursor-pointer ml-1 relative"
                    id="user-menu-btn">
                    <i class="fas fa-bars text-gray-500 text-sm"></i>
                    <div
                        class="bg-gray-500 text-white rounded-full p-1 w-8 h-8 flex items-center justify-center overflow-hidden">
                        <% if(curruser) { %>
                            <span class="text-xs font-bold">
                                <%= curruser.username[0].toUpperCase() %>
                            </span>
                            <% } else { %>
                                <i class="fas fa-user text-xs"></i>
                                <% } %>
                    </div>
                </div>

            </div>

            <!-- Mobile Menu Button -->
            <div class="md:hidden flex items-center gap-4">
                <div class="bg-white border rounded-full shadow-sm p-2 flex items-center justify-center w-10 h-10">
                    <i class="fas fa-search text-[#FF385C]"></i>
                </div>
                <button id="mobile-menu-btn"
                    class="text-gray-600 hover:text-gray-900 focus:outline-none border p-2 rounded-full">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- User Dropdown (Hidden) -->
    <div id="user-dropdown"
        class="hidden absolute top-20 right-20 bg-white rounded-xl shadow-float w-64 py-2 border border-gray-100 overflow-hidden z-[60]">
        <% if(!curruser) { %>
            <a href="/users/login"
                class="block px-4 py-3 hover:bg-gray-50 font-semibold text-gray-800 text-decoration-none">Log in</a>
            <a href="/users/signup" class="block px-4 py-3 hover:bg-gray-50 text-gray-600 text-decoration-none">Sign
                up</a>
            <% } else { %>
                <div class="px-4 py-3 border-b text-sm font-semibold">Messages</div>
                <div class="px-4 py-3 border-b text-sm font-semibold">Trips</div>
                <div class="px-4 py-3 border-b text-sm font-semibold">Wishlists</div>
                <div class="border-t mt-2">
                    <a href="/logout" class="block px-4 py-3 hover:bg-gray-50 text-gray-600 text-decoration-none">Log
                        out</a>
                </div>
                <% } %>
                    <div class="border-t mt-2">
                        <a href="#" class="block px-4 py-3 hover:bg-gray-50 text-gray-600 text-decoration-none">Help
                            Center</a>
                    </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="hidden absolute top-20 left-0 w-full bg-white shadow-lg border-t z-50 p-4 md:hidden">
        <div class="flex flex-col gap-4">
            <a href="/listings" class="font-semibold text-gray-800">Explore</a>
            <a href="/listings/new" class="font-semibold text-gray-800">Rent home</a>
            <hr>
            <% if(!curruser) { %>
                <a href="/users/login" class="font-semibold text-gray-800">Log in</a>
                <a href="/users/signup" class="font-semibold text-gray-800">Sign up</a>
                <% } else { %>
                    <a href="/logout" class="font-semibold text-red-500">Log out</a>
                    <% } %>
        </div>
    </div>

    <script>
        const menuBtn = document.getElementById('user-menu-btn');
        const dropdown = document.getElementById('user-dropdown');
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            dropdown.classList.toggle('hidden');
        });

        mobileBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.addEventListener('click', () => {
            dropdown.classList.add('hidden');
        });
    </script>
</nav>
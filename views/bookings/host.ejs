<% layout("./layouts/boilerplate.ejs") %>

    <div class="max-w-7xl mx-auto px-6 py-10 font-[Outfit]">
        <div class="flex justify-between items-end mb-8">
            <div>
                <h1 class="text-3xl font-extrabold text-[#222222] mb-2">Host Dashboard</h1>
                <p class="text-gray-500">Manage your incoming reservations.</p>
            </div>
            <div class="hidden sm:block">
                <a href="/listings/new"
                    class="px-5 py-2.5 bg-black text-white rounded-xl font-bold text-sm hover:bg-gray-800 transition-colors">
                    <i class="fas fa-plus mr-2"></i> Create Listing
                </a>
            </div>
        </div>

        <% if(bookings && bookings.length> 0) { %>
            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full whitespace-nowrap">
                        <thead>
                            <tr class="bg-gray-50/50 border-b border-gray-100">
                                <th
                                    class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Property</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Guest</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Dates</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Total</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Status</th>
                                <th
                                    class="px-6 py-4 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">
                                    Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% bookings.forEach(booking=> { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-lg bg-gray-100 overflow-hidden flex-shrink-0">
                                                <img src="<%= booking.listing.image.url %>"
                                                    class="w-full h-full object-cover">
                                            </div>
                                            <a href="/listings/<%= booking.listing._id %>"
                                                class="font-bold text-[#222222] hover:underline hover:text-[#FF385C]">
                                                <%= booking.listing.name %>
                                            </a>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <div
                                                class="w-6 h-6 rounded-full bg-gray-900 text-white flex items-center justify-center text-xs font-bold">
                                                <%= booking.booker.username[0].toUpperCase() %>
                                            </div>
                                            <span class="font-medium text-gray-700">
                                                <%= booking.booker.username %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col text-sm">
                                            <span class="font-bold text-gray-700">
                                                <%= new Date(booking.checkIn).toLocaleDateString('en-US',
                                                    {month:'short', day:'numeric'}) %>
                                                    -
                                                    <%= new Date(booking.checkOut).toLocaleDateString('en-US',
                                                        {month:'short', day:'numeric'}) %>
                                            </span>
                                            <span class="text-xs text-gray-400">
                                                <%= Math.round(Math.abs((new Date(booking.checkOut) - new
                                                    Date(booking.checkIn)) / (24 * 60 * 60 * 1000))) %> nights
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-bold text-[#222222]">
                                        ₹<%= booking.totalPrice.toLocaleString('en-IN') %>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span
                                            class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-800">
                                            Confirmed
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <button class="text-gray-400 hover:text-black transition-colors"
                                            title="Message Guest">
                                            <i class="far fa-envelope text-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
            <% } else { %>
                <div class="bg-gray-50 rounded-3xl border border-dashed border-gray-300 p-12 text-center">
                    <div
                        class="w-16 h-16 bg-white rounded-full text-gray-400 text-2xl flex items-center justify-center mx-auto shadow-sm mb-4">
                        <i class="fas fa-inbox"></i>
                    </div>
                    <h3 class="text-xl font-bold text-[#222222] mb-2">No bookings yet</h3>
                    <p class="text-gray-500 max-w-sm mx-auto mb-6">When guests book your properties, they'll appear
                        here.</p>
                </div>
                <% } %>
    </div>
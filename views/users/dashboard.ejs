<% layout("./layouts/boilerplate.ejs") %>

    <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-[#222222] mb-1">Host Dashboard</h1>
                <p class="text-gray-500 text-sm">Manage your listings and view incoming reservations.</p>
            </div>
            <a href="/listings/new"
                class="bg-[#FF385C] text-white px-6 py-3 rounded-xl font-bold hover:bg-[#D90B3E] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-[0.99] flex items-center gap-2">
                <i class="fas fa-plus"></i> Create New Listing
            </a>
        </div>

        <!-- Stats Overview -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Total Earnings</p>
                <h3 class="text-3xl font-extrabold text-[#222222] tracking-tight">₹<%= incomingBookings.reduce((acc,
                        b)=> acc +
                        b.totalPrice, 0).toLocaleString('en-IN') %></h3>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Total Bookings</p>
                <h3 class="text-3xl font-extrabold text-[#222222] tracking-tight">
                    <%= incomingBookings.length %>
                </h3>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Active Listings</p>
                <h3 class="text-3xl font-extrabold text-[#222222] tracking-tight">
                    <%= listings.length %>
                </h3>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

            <!-- Left Column: Incoming Bookings -->
            <div>
                <h2 class="text-xl font-bold text-[#222222] mb-6 flex items-center gap-2">
                    <i class="fas fa-inbox text-gray-400"></i> Incoming Reservations
                </h2>

                <% if(incomingBookings && incomingBookings.length> 0) { %>
                    <div class="space-y-4">
                        <% for(let booking of incomingBookings) { %>
                            <div
                                class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md transition-all duration-300 hover:border-gray-300 group">
                                <div class="flex gap-4">
                                    <div class="w-16 h-16 rounded-lg bg-gray-200 overflow-hidden shrink-0 relative">
                                        <img src="<%= booking.listing.image.url %>" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <div class="flex justify-between items-start">
                                            <h4
                                                class="font-bold text-[#222222] text-sm group-hover:text-[#FF385C] transition-colors">
                                                <%= booking.listing.name %>
                                            </h4>
                                            <span
                                                class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-1 rounded-full uppercase tracking-wide">Confirmed</span>
                                        </div>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Guest: <span class="font-semibold text-gray-700">
                                                <%= booking.booker.username %>
                                            </span>
                                        </p>
                                        <div class="flex items-center gap-3 mt-3 text-xs text-gray-600">
                                            <span
                                                class="bg-gray-50 border border-gray-100 px-2 py-1 rounded-md font-medium">
                                                <%= new Date(booking.checkIn).toLocaleDateString('en-US',
                                                    {month:'short', day:'numeric'}) %> -
                                                    <%= new Date(booking.checkOut).toLocaleDateString('en-US',
                                                        {month:'short', day:'numeric'}) %>
                                            </span>
                                            <span class="font-bold text-[#222222]">₹<%=
                                                    booking.totalPrice.toLocaleString('en-IN') %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <% } else { %>
                        <div class="text-center py-12 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
                            <i class="fas fa-clipboard-list text-gray-300 text-3xl mb-3"></i>
                            <p class="text-gray-400 text-sm">No bookings received yet.</p>
                        </div>
                        <% } %>
            </div>

            <!-- Right Column: My Listings -->
            <div>
                <h2 class="text-xl font-bold text-[#222222] mb-6 flex items-center gap-2">
                    <i class="fas fa-home text-gray-400"></i> My Properties
                </h2>

                <% if(listings && listings.length> 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <% for(let listing of listings) { %>
                            <div
                                class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300 hover:border-gray-300">
                                <div class="aspect-[4/3] bg-gray-200 relative overflow-hidden">
                                    <img src="<%= listing.image.url %>"
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                    <div
                                        class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <a href="/listings/<%= listing._id %>/edit"
                                            class="bg-white/90 backdrop-blur-sm text-gray-700 p-2 rounded-lg shadow-sm hover:scale-110 transition-transform">
                                            <i class="fas fa-edit text-xs"></i>
                                        </a>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h4
                                        class="font-bold text-[#222222] text-sm truncate mb-1 group-hover:text-[#FF385C] transition-colors">
                                        <%= listing.name %>
                                    </h4>
                                    <p class="text-xs text-gray-500 mb-3 truncate">
                                        <%= listing.location %>
                                    </p>
                                    <a href="/listings/<%= listing._id %>"
                                        class="text-[11px] font-bold text-[#222222] uppercase tracking-wider hover:underline flex items-center gap-1">
                                        View Listing <i class="fas fa-arrow-right text-[9px]"></i>
                                    </a>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <% } else { %>
                        <div class="text-center py-12 bg-gray-50 rounded-2xl border border-dashed border-gray-200">
                            <i class="fas fa-home text-gray-300 text-3xl mb-3"></i>
                            <p class="text-gray-400 text-sm mb-4">You haven't posted any listings.</p>
                            <a href="/listings/new" class="text-[#FF385C] text-sm font-bold hover:underline">Start
                                Hosting</a>
                        </div>
                        <% } %>
            </div>

        </div>
    </div>
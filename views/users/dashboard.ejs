<% layout("./layouts/boilerplate.ejs") %>

    <div class="max-w-7xl mx-auto px-6 py-10">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-[#222222] mb-1">Dashboard</h1>
                <p class="text-gray-500 text-sm">Welcome back, <%= curruser.username %>!</p>
            </div>
            <a href="/listings/new"
                class="bg-[#FF385C] text-white px-6 py-3 rounded-xl font-bold hover:bg-[#D90B3E] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-[0.99] flex items-center gap-2">
                <i class="fas fa-plus"></i> Create New Listing
            </a>
        </div>

        <!-- TABS / SECTIONS -->
        <div class="space-y-16">

            <!-- SECTION 1: MY TRIPS (Traveling) -->
            <section>
                <h2 class="text-2xl font-bold text-[#222222] mb-6 flex items-center gap-2">
                    <i class="fas fa-plane-departure text-[#FF385C]"></i> My Trips
                </h2>

                <% if(myTrips && myTrips.length> 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% for(let trip of myTrips) { %>
                            <div
                                class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group">
                                <div class="flex h-32">
                                    <div class="w-1/3 bg-gray-200 relative">
                                        <img src="<%= trip.listing.image.url %>" class="w-full h-full object-cover">
                                    </div>
                                    <div class="w-2/3 p-4 flex flex-col justify-between">
                                        <div>
                                            <h4
                                                class="font-bold text-[#222222] text-sm line-clamp-1 group-hover:text-[#FF385C] transition-colors">
                                                <%= trip.listing.name %>
                                            </h4>
                                            <p class="text-xs text-gray-500 line-clamp-1">
                                                <%= trip.listing.location %>
                                            </p>
                                        </div>
                                        <div class="flex justify-between items-end">
                                            <div class="text-xs font-medium text-gray-600">
                                                <%= new Date(trip.checkIn).toLocaleDateString(undefined, {month:'short',
                                                    day:'numeric'}) %> -
                                                    <%= new Date(trip.checkOut).toLocaleDateString(undefined,
                                                        {month:'short', day:'numeric'}) %>
                                            </div>
                                            <span
                                                class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">
                                                <%= trip.status %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                    </div>
                    <% } else { %>
                        <div class="bg-gray-50 border border-dashed border-gray-200 rounded-xl p-8 text-center">
                            <div
                                class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                                <i class="fas fa-suitcase text-gray-400"></i>
                            </div>
                            <h3 class="text-sm font-bold text-gray-900">No trips booked... yet!</h3>
                            <p class="text-xs text-gray-500 mt-1 mb-4">Time to dust off your bags and start exploring.
                            </p>
                            <a href="/listings" class="text-[#FF385C] text-sm font-bold hover:underline">Start
                                searching</a>
                        </div>
                        <% } %>
            </section>

            <!-- DIVIDER -->
            <div class="border-t border-gray-200"></div>

            <!-- SECTION 2: HOSTING (My Listings & Incoming Bookings) -->
            <section>
                <h2 class="text-2xl font-bold text-[#222222] mb-8 flex items-center gap-2">
                    <i class="fas fa-building-user text-gray-400"></i> Hosting Dashboard
                </h2>

                <!-- Hosting Stats -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Total Earnings</p>
                        <h3 class="text-3xl font-extrabold text-[#222222] tracking-tight">₹<%=
                                incomingBookings.reduce((acc, b)=> acc + b.totalPrice, 0).toLocaleString('en-IN') %>
                        </h3>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Reservations</p>
                        <h3 class="text-3xl font-extrabold text-[#222222] tracking-tight">
                            <%= incomingBookings.length %>
                        </h3>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-1">Active Listings</p>
                        <h3 class="text-3xl font-extrabold text-[#222222] tracking-tight">
                            <%= listings.length %>
                        </h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                    <!-- Incoming Bookings -->
                    <div>
                        <h3 class="text-lg font-bold text-[#222222] mb-4">Incoming Reservations</h3>
                        <% if(incomingBookings && incomingBookings.length> 0) { %>
                            <div class="space-y-4">
                                <% for(let booking of incomingBookings) { %>
                                    <div
                                        class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:shadow-md transition-all flex gap-4">
                                        <div class="w-12 h-12 rounded-full bg-gray-100 overflow-hidden shrink-0">
                                            <img src="<%= booking.listing.image.url %>"
                                                class="w-full h-full object-cover">
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <p class="text-xs text-gray-500">Guest</p>
                                                    <h4 class="font-bold text-[#222222] text-sm">
                                                        <%= booking.booker.username %>
                                                    </h4>
                                                </div>
                                                <span
                                                    class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-0.5 rounded-full uppercase">Confirmed</span>
                                            </div>
                                            <div class="mt-2 text-xs text-gray-600 flex justify-between items-center">
                                                <span>
                                                    <%= new Date(booking.checkIn).toLocaleDateString(undefined,
                                                        {month:'short', day:'numeric'}) %> -
                                                        <%= new Date(booking.checkOut).toLocaleDateString(undefined,
                                                            {month:'short', day:'numeric'}) %>
                                                </span>
                                                <span class="font-bold">₹<%= booking.totalPrice.toLocaleString('en-IN')
                                                        %></span>
                                            </div>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div
                                    class="text-center py-8 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                                    <p class="text-gray-400 text-xs">No incoming reservations.</p>
                                </div>
                                <% } %>
                    </div>

                    <!-- My Listings -->
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-bold text-[#222222]">My Properties</h3>
                        </div>
                        <% if(listings && listings.length> 0) { %>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <% for(let listing of listings) { %>
                                    <div
                                        class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition-all">
                                        <div class="aspect-[3/2] bg-gray-200 relative">
                                            <img src="<%= listing.image.url %>"
                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                            <a href="/listings/<%= listing._id %>/edit"
                                                class="absolute top-2 right-2 bg-white/90 p-1.5 rounded-lg shadow-sm hover:scale-110 transition-transform opacity-0 group-hover:opacity-100">
                                                <i class="fas fa-edit text-xs text-black"></i>
                                            </a>
                                        </div>
                                        <div class="p-3">
                                            <h4 class="font-bold text-[#222222] text-xs truncate mb-0.5">
                                                <%= listing.name %>
                                            </h4>
                                            <p class="text-[10px] text-gray-500 truncate">
                                                <%= listing.location %>
                                            </p>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div
                                    class="text-center py-8 bg-gray-50 rounded-xl border border-dashed border-gray-200">
                                    <p class="text-gray-400 text-xs mb-3">No properties listed.</p>
                                    <a href="/listings/new"
                                        class="text-[#FF385C] text-xs font-bold hover:underline">Start Hosting</a>
                                </div>
                                <% } %>
                    </div>
                </div>
            </section>

        </div>
    </div>
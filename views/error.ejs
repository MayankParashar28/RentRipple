<% layout("./layouts/boilerplate.ejs") %>

    <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
        <div class="mb-6 text-[#FA2D55]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
        </div>

        <h1 class="text-4xl font-bold text-[#222222] mb-3">Oops! Something went wrong.</h1>

        <p class="text-xl text-gray-600 mb-8 max-w-lg mx-auto">
            <%= message %>
        </p>

        <div class="flex gap-4">
            <a href="/"
                class="px-6 py-3 bg-[#FA2D55] text-white font-semibold rounded-xl shadow-md hover:bg-[#D92648] hover:shadow-lg transition-all">
                Explore Listings
            </a>
            <button onclick="history.back()"
                class="px-6 py-3 bg-white border border-gray-200 text-gray-700 font-semibold rounded-xl shadow-sm hover:bg-gray-50 hover:shadow-md transition-all">
                Go Back
            </button>
        </div>
    </div>
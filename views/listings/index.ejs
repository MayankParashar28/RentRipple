<% layout("./layouts/boilerplate.ejs") %>
    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Main Container -->
    <div class="listings-container">

        <!-- Category Filters -->
        <div class="filters-container">
            <div class="filter-item active">
                <i class="fas fa-ticket-alt"></i>
                <span>Icons</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-fire"></i>
                <span>Trending</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-bed"></i>
                <span>Rooms</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-city"></i>
                <span>Top Cities</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-mountain"></i>
                <span>Countryside</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-chess-rook"></i>
                <span>Castles</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-water"></i>
                <span>Pools</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-campground"></i>
                <span>Camping</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-tractor"></i>
                <span>Farms</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-snowflake"></i>
                <span>Arctic</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-umbrella-beach"></i>
                <span>Beach</span>
            </div>
            <div class="filter-item">
                <i class="fas fa-ship"></i>
                <span>Boats</span>
            </div>

            <div class="tax-toggle hidden md:flex">
                <div class="form-check form-switch form-check-reverse p-0 m-0 flex gap-2 items-center">
                    <label class="form-check-label text-xs font-semibold m-0 cursor-pointer"
                        for="flexSwitchCheckDefault">Display total before taxes</label>
                    <input class="form-check-input m-0 cursor-pointer" type="checkbox" role="switch"
                        id="flexSwitchCheckDefault">
                </div>
            </div>
        </div>

        <!-- Listings Grid -->
        <div class="listings-grid">
            <% listings.forEach((listing, index)=> {
                // Reliable Rating Text
                let ratingText = "New";
                if(listing.reviews && listing.reviews.length > 0) {
                let total = 0;
                listing.reviews.forEach(r => total += r.rating || 0);
                ratingText = (total / listing.reviews.length).toFixed(1); // "4.8"
                }
                %>
                <a href="/listings/<%= listing._id %>" class="listing-card animate-fade-in"
                    style="animation-delay: <%= index * 0.05 %>s">
                    <!-- Image -->
                    <div class="image-container">
                        <img class="listing-image" src="<%= listing.image.url %>" alt="<%= listing.name %>">
                        <div class="image-overlay"></div>
                        <button class="favorite-btn">
                            <i class="fas fa-heart"></i>
                        </button>
                    </div>

                    <!-- Content (Airbnb Style) -->
                    <div class="card-content">
                        <div class="listing-header">
                            <h2 class="listing-title">
                                <%= listing.location %>, <%= listing.country %>
                            </h2>
                            <div class="rating-badge">
                                <i class="fas fa-star text-black"></i>
                                <span>
                                    <%= ratingText %>
                                </span>
                            </div>
                        </div>

                        <p class="listing-subtitle text-gray-500">Hosted by <%= listing.owner ? listing.owner.username
                                : 'Host' %>
                        </p>
                        <p class="listing-subtitle text-gray-500">Oct 23 - 28</p>

                        <div class="price-container mt-1">
                            <span class="price text-black">₹<%= listing.price ? listing.price.toLocaleString("en-IN") :
                                    0 %></span>
                            <span class="price-period"> night</span>
                        </div>
                    </div>
                </a>
                <% }); %>
        </div>
    </div>

    <!-- Map Script -->
    <script>
        const listingsGeoJSON = {
            type: "FeatureCollection",
            features: <% - JSON.stringify(listings) %>
        };
    </script>
    <script src="/js/clusterMap.js"></script>

    <!-- Client-side Interactions -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Animation
            const cards = document.querySelectorAll('.animate-fade-in');
            cards.forEach(card => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            });

            // Filter Click Interaction
            const filters = document.querySelectorAll('.filter-item');
            filters.forEach(f => {
                f.addEventListener('click', () => {
                    filters.forEach(i => i.classList.remove('active'));
                    f.classList.add('active');
                });
            });

            // Favorite Toggle
            const hearts = document.querySelectorAll('.favorite-btn');
            hearts.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    btn.classList.toggle('active');
                    const icon = btn.querySelector('i');
                    // Toggle Solid/Regular if needed, or just relying on color
                    icon.classList.add('fas');
                });
            });
        });
    </script>
    </body>
<% layout("./layouts/boilerplate.ejs") %>
    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Main Container -->
    <div class="max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Category Filters (Sticky & Premium) -->
        <!-- Category Filters (Sticky & Premium) -->
        <div>
            <div
                class="fixed top-[5rem] left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border border-gray-200 rounded-2xl shadow-sm py-2 mx-4 md:mx-auto md:max-w-[96%]">
                <div class="max-w-[99.5%] mx-auto flex items-center gap-4 px-4 overflow-hidden h-12">

                    <!-- Filters Scroll Area (Icons Only) -->
                    <div
                        class="flex-1 flex items-center justify-center gap-4 overflow-x-auto overflow-y-hidden no-scrollbar scroll-smooth h-full">

                        <div onclick="window.location.href='/?category=Beach'" title="Beach"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Beach') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-umbrella-beach text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Mountains'" title="Mountains"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-mountain text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Cities'" title="Cities"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Cities') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-city text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Castle'" title="Castle"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Castle') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-chess-rook text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Pools'" title="Pools"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Pools') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-water text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Camping'" title="Camping"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Camping') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-campground text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Farms'" title="Farms"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Farms') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-tractor text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Arctic'" title="Arctic"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-snowflake text-base"></i>
                        </div>

                        <div onclick="window.location.href='/?category=Deserts'" title="Deserts"
                            class="filter-item flex flex-col items-center justify-center w-10 h-10 rounded-full border <%= (typeof category !== 'undefined' && category === 'Deserts') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-sun text-base"></i>
                        </div>

                    </div>

                    <!-- Tax Toggle Switch -->
                    <div
                        class="hidden md:flex items-center gap-2 border border-gray-200 rounded-xl px-3 py-2 ml-2 shadow-sm hover:shadow-md transition-all cursor-pointer">
                        <span class="text-xs font-semibold text-gray-700 whitespace-nowrap">Display total before
                            taxes</span>
                        <div
                            class="relative inline-block w-9 h-5 align-middle select-none transition duration-200 ease-in">
                            <input type="checkbox" name="toggle" id="toggle"
                                class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer border-gray-300" />
                            <label for="toggle"
                                class="toggle-label block overflow-hidden h-5 rounded-full bg-gray-300 cursor-pointer"></label>
                        </div>
                    </div>



                </div>
            </div>

            <!-- Skeleton Loading Grid -->
            <div id="skeleton-loading"
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-6 gap-y-10 pt-44 w-full px-2">
                <% for(let i=0; i<12; i++) { %>
                    <div class="flex flex-col animate-pulse">
                        <div class="w-full aspect-square rounded-xl mb-3 bg-gray-200"></div>
                        <div class="space-y-2">
                            <div class="flex justify-between items-start">
                                <div class="w-2/3 h-4 bg-gray-200 rounded-md"></div>
                                <div class="w-10 h-4 bg-gray-200 rounded-md"></div>
                            </div>
                            <div class="w-1/2 h-3 bg-gray-200 rounded-md"></div>
                            <div class="w-1/3 h-4 bg-gray-200 rounded-md mt-1"></div>
                        </div>
                    </div>
                    <% } %>
            </div>

            <!-- Actual Listings Grid -->
            <div id="actual-listings"
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-6 gap-y-10 pt-44 pb-20 w-full hidden px-2">
                <% listings.forEach((listing, index)=> {
                    let ratingText = "New";
                    let reviewCount = listing.reviews ? listing.reviews.length : 0;
                    if(reviewCount > 0) {
                    let total = 0;
                    listing.reviews.forEach(r => total += r.rating || 0);
                    ratingText = (total / reviewCount).toFixed(1);
                    }
                    %>
                    <div class="group flex flex-col cursor-pointer h-full animate-fade-in relative"
                        style="animation-delay: <%= index * 0.05 %>s">

                        <!-- Image Container -->
                        <div class="relative w-full aspect-square overflow-hidden rounded-xl bg-gray-200 mb-3">
                            <a href="/listings/<%= listing._id %>" class="block w-full h-full">
                                <img src="<%= listing.image.url %>"
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    alt="<%= listing.name %>">
                            </a>

                            <!-- Heart Icon -->
                            <div class="absolute top-3 right-3 z-10">
                                <% if(curruser) { %>
                                    <form action="/wishlist/<%= listing._id %>" method="POST" class="inline-block"
                                        onclick="event.stopPropagation();">
                                        <button type="submit"
                                            class="p-0 border-0 bg-transparent cursor-pointer hover:scale-110 active:scale-95 transition-transform">
                                            <i class="fas fa-heart text-2xl <%= wishlist.includes(listing._id.toString()) ? 'text-[#FF385C]' : 'text-black/50' %>"
                                                style="<%= wishlist.includes(listing._id.toString()) ? '' : '-webkit-text-stroke: 1.5px white;' %> filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));"></i>
                                        </button>
                                    </form>
                                    <% } else { %>
                                        <span class="hover:scale-110 transition-transform inline-block">
                                            <i class="fas fa-heart text-2xl text-black/50"
                                                style="-webkit-text-stroke: 1.5px white; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));"></i>
                                        </span>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Listing Details -->
                        <a href="/listings/<%= listing._id %>" class="flex flex-col gap-1 no-underline">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-[#222222] truncate flex-1 pr-2 text-[15px]">
                                    <%= listing.location %>, <%= listing.country %>
                                </h3>
                                <div class="flex items-center gap-1 text-[14px] text-[#222222]">
                                    <i class="fas fa-star text-[12px]"></i>
                                    <span>
                                        <%= ratingText %>
                                    </span>
                                </div>
                            </div>
                            <p class="text-gray-500 text-[15px] truncate leading-tight">
                                Hosted by <%= listing.owner ? listing.owner.username : 'Host' %>
                            </p>
                            <p class="text-gray-500 text-[15px] leading-tight">Available now</p>
                            <div class="flex items-baseline gap-1 mt-1.5">
                                <span class="font-bold text-[#222222] text-[15px]">₹<%= listing.price ?
                                        listing.price.toLocaleString("en-IN") : 0 %></span>
                                <span class="text-[#222222] font-normal text-[15px]">night</span>
                            </div>
                        </a>

                    </div>
                    <% }); %>
            </div>

            <!-- Map Container -->
            <div id="map-container" class="hidden fixed inset-0 top-[5rem] bg-gray-100 z-30 transition-all p-6">
                <div id="map" class="w-full h-full rounded-2xl overflow-hidden shadow-2xl"></div>
            </div>

            <!-- Floating Map Toggle -->
            <div class="fixed bottom-12 left-1/2 -translate-x-1/2 z-40">
                <button id="db-map-toggle" onclick="toggleMap()"
                    class="bg-[#222222] hover:scale-105 text-white px-6 py-3.5 rounded-full font-semibold shadow-xl flex items-center gap-2 transition-transform active:scale-95 group">
                    <span id="toggle-text">Show map</span>
                    <i id="toggle-icon" class="fas fa-map text-sm"></i>
                </button>
            </div>

        </div>

        <!-- Map Scripts -->
        <script>
            window.mapData = {
                mapToken: "<%- mapToken %>",
                listings: <%- JSON.stringify(mapListings || []) %>
            };
        </script>
        <script src="/js/clusterMap.js"></script>

        <script>
            function toggleMap() {
                const mapContainer = document.getElementById('map-container');
                const listingsContainer = document.getElementById('actual-listings');
                const toggleText = document.getElementById('toggle-text');
                const toggleIcon = document.getElementById('toggle-icon');
                const skeletons = document.getElementById('skeleton-loading');

                if (mapContainer.classList.contains('hidden')) {
                    // Show Map
                    mapContainer.classList.remove('hidden');
                    listingsContainer.classList.add('hidden');
                    if (skeletons) skeletons.classList.add('hidden');
                    toggleText.innerText = "Show list";
                    toggleIcon.classList.remove('fa-map');
                    toggleIcon.classList.add('fa-list');

                    setTimeout(() => {
                        if (window.map) {
                            window.map.resize();
                        }
                    }, 100);
                } else {
                    // Show List
                    mapContainer.classList.add('hidden');
                    listingsContainer.classList.remove('hidden');
                    toggleText.innerText = "Show map";
                    toggleIcon.classList.remove('fa-list');
                    toggleIcon.classList.add('fa-map');
                }
            }

            document.addEventListener('DOMContentLoaded', () => {
                const skeleton = document.getElementById('skeleton-loading');
                const actual = document.getElementById('actual-listings');

                setTimeout(() => {
                    if (skeleton) skeleton.classList.add('hidden');
                    if (actual && document.getElementById('map-container').classList.contains('hidden')) {
                        actual.classList.remove('hidden');
                    }
                    const cards = document.querySelectorAll('.animate-fade-in');
                    cards.forEach(card => {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    });
                }, 800);
            });
        </script>
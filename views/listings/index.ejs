<% layout("./layouts/boilerplate.ejs") %>
    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Main Container -->
    <div class="max-w-[1920px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Category Filters (Sticky & Premium) -->
        <!-- Category Filters (Sticky & Premium) -->
        <div>
            <div
                class="fixed top-[6rem] left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border border-gray-200 rounded-2xl shadow-sm py-2 mx-4 md:mx-auto md:max-w-[96%]">
                <div class="max-w-[99.5%] mx-auto flex items-center gap-4 px-4 overflow-hidden h-12">

                    <!-- Filters Scroll Area (Icons Only) -->
                    <div
                        class="flex-1 flex items-center justify-center gap-4 overflow-x-auto overflow-y-hidden no-scrollbar scroll-smooth h-full">

                        <div onclick="window.location.href='/?category=Beach'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Beach') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-umbrella-beach text-sm"></i>
                            <span class="text-sm font-medium">Beach</span>
                        </div>

                        <div onclick="window.location.href='/?category=Mountains'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-mountain text-sm"></i>
                            <span class="text-sm font-medium">Mountains</span>
                        </div>

                        <div onclick="window.location.href='/?category=Cities'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Cities') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-city text-sm"></i>
                            <span class="text-sm font-medium">Cities</span>
                        </div>

                        <div onclick="window.location.href='/?category=Castle'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Castle') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-chess-rook text-sm"></i>
                            <span class="text-sm font-medium">Castle</span>
                        </div>

                        <div onclick="window.location.href='/?category=Pools'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Pools') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-water text-sm"></i>
                            <span class="text-sm font-medium">Pools</span>
                        </div>

                        <div onclick="window.location.href='/?category=Camping'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Camping') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-campground text-sm"></i>
                            <span class="text-sm font-medium">Camping</span>
                        </div>

                        <div onclick="window.location.href='/?category=Farms'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Farms') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-tractor text-sm"></i>
                            <span class="text-sm font-medium">Farms</span>
                        </div>

                        <div onclick="window.location.href='/?category=Arctic'"
                            class="filter-item flex flex-row items-center justify-center h-8 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-snowflake text-sm"></i>
                            <span class="text-sm font-medium">Arctic</span>
                        </div>

                        <div onclick="window.location.href='/?category=Deserts'"
                            class="filter-item flex flex-row items-center justify-center h-10 px-4 gap-2 rounded-full border <%= (typeof category !== 'undefined' && category === 'Deserts') ? 'bg-black text-white border-black shadow-md' : 'bg-transparent text-gray-500 hover:bg-gray-100 border-transparent' %> cursor-pointer group transition-all shrink-0">
                            <i class="fas fa-sun text-sm"></i>
                            <span class="text-sm font-medium">Deserts</span>
                        </div>

                    </div>





                </div>
            </div>

            <!-- Skeleton Loading Grid -->
            <div id="skeleton-loading"
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-6 gap-y-10 pt-52 w-full px-2">
                <% for(let i=0; i<12; i++) { %>
                    <div class="flex flex-col animate-pulse">
                        <div class="w-full aspect-square rounded-xl mb-3 bg-gray-200"></div>
                        <div class="space-y-2">
                            <div class="flex justify-between items-start">
                                <div class="w-2/3 h-4 bg-gray-200 rounded-md"></div>
                                <div class="w-10 h-4 bg-gray-200 rounded-md"></div>
                            </div>
                            <div class="w-1/2 h-3 bg-gray-200 rounded-md"></div>
                            <div class="w-1/3 h-4 bg-gray-200 rounded-md mt-1"></div>
                        </div>
                    </div>
                    <% } %>
            </div>

            <!-- Actual Listings Grid -->
            <div id="actual-listings"
                class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-x-6 gap-y-10 pt-52 pb-20 w-full hidden px-2">
                <% listings.forEach((listing, index)=> {
                    let ratingText = "New";
                    let reviewCount = listing.reviews ? listing.reviews.length : 0;
                    if(reviewCount > 0) {
                    let total = 0;
                    listing.reviews.forEach(r => total += r.rating || 0);
                    ratingText = (total / reviewCount).toFixed(1);
                    }
                    %>
                    <div class="group flex flex-col cursor-pointer h-full animate-fade-in relative"
                        style="animation-delay: <%= index * 0.05 %>s">

                        <!-- Image Container -->
                        <div class="relative w-full aspect-square overflow-hidden rounded-xl bg-gray-200 mb-3">
                            <a href="/listings/<%= listing._id %>" class="block w-full h-full">
                                <img src="<%= listing.image.url %>"
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    alt="<%= listing.name %>">
                            </a>

                            <!-- Heart Icon -->
                            <div class="absolute top-3 right-3 z-10">
                                <% if(curruser) { %>
                                    <form action="/wishlist/<%= listing._id %>" method="POST" class="inline-block"
                                        onclick="event.stopPropagation();">
                                        <button type="submit"
                                            class="p-0 border-0 bg-transparent cursor-pointer hover:scale-110 active:scale-95 transition-transform">
                                            <i class="fas fa-heart text-2xl <%= wishlist.includes(listing._id.toString()) ? 'text-[#FF385C]' : 'text-black/50' %>"
                                                style="<%= wishlist.includes(listing._id.toString()) ? '' : '-webkit-text-stroke: 1.5px white;' %> filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));"></i>
                                        </button>
                                    </form>
                                    <% } else { %>
                                        <span class="hover:scale-110 transition-transform inline-block">
                                            <i class="fas fa-heart text-2xl text-black/50"
                                                style="-webkit-text-stroke: 1.5px white; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.15));"></i>
                                        </span>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Listing Details -->
                        <a href="/listings/<%= listing._id %>" class="flex flex-col gap-1 no-underline">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-[#222222] truncate flex-1 pr-2 text-[15px]">
                                    <%= listing.location %>, <%= listing.country %>
                                </h3>
                                <div class="flex items-center gap-1 text-[14px] text-[#222222]">
                                    <i class="fas fa-star text-[12px]"></i>
                                    <span>
                                        <%= ratingText %>
                                    </span>
                                </div>
                            </div>
                            <p class="text-gray-500 text-[15px] truncate leading-tight">
                                Hosted by <%= listing.owner ? listing.owner.username : 'Host' %>
                            </p>
                            <p class="text-gray-500 text-[15px] leading-tight">Available now</p>
                            <div class="flex items-baseline gap-1 mt-1.5">
                                <span class="font-bold text-[#222222] text-[15px]">₹<%= listing.price ?
                                        listing.price.toLocaleString("en-IN") : 0 %></span>
                                <span class="text-[#222222] font-normal text-[15px]">night</span>
                            </div>
                        </a>

                    </div>
                    <% }); %>
            </div>



        </div>



        <script>


            document.addEventListener('DOMContentLoaded', () => {
                const skeleton = document.getElementById('skeleton-loading');
                const actual = document.getElementById('actual-listings');

                setTimeout(() => {
                    if (skeleton) skeleton.classList.add('hidden');
                    if (actual) {
                        actual.classList.remove('hidden');
                    }
                    const cards = document.querySelectorAll('.animate-fade-in');
                    cards.forEach(card => {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    });
                }, 800);
            });
        </script>
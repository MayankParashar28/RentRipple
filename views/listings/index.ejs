<% layout("./layouts/boilerplate.ejs") %>
    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <!-- Main Container -->
    <div class="listings-container">

        <!-- Category Filters -->
        <div
            class="fixed top-[5.5rem] left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border border-gray-200 rounded-2xl shadow-sm py-3 mx-4 md:mx-auto md:max-w-[96%]">
            <div class="max-w-[99.5%] mx-auto flex items-center gap-4 px-4 overflow-hidden h-14">

                <!-- Filters Scroll Area -->
                <div
                    class="flex-1 flex items-center gap-3 overflow-x-auto overflow-y-hidden no-scrollbar scroll-smooth h-full">
                    <div onclick="window.location.href='/?category=Beach'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Beach') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-umbrella-beach text-sm <%= (typeof category !== 'undefined' && category === 'Beach') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Beach') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Beach</span>
                    </div>
                    <div onclick="window.location.href='/?category=Mountains'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-mountain text-sm <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Mountain</span>
                    </div>
                    <div onclick="window.location.href='/?category=Cities'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Cities') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-city text-sm <%= (typeof category !== 'undefined' && category === 'Cities') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Cities') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Cities</span>
                    </div>
                    <div onclick="window.location.href='/?category=Castle'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Castle') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-chess-rook text-sm <%= (typeof category !== 'undefined' && category === 'Castle') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Castle') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Castles</span>
                    </div>
                    <div onclick="window.location.href='/?category=Pools'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Pools') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-water text-sm <%= (typeof category !== 'undefined' && category === 'Pools') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Pools') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Pools</span>
                    </div>
                    <div onclick="window.location.href='/?category=Camping'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Camping') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-campground text-sm <%= (typeof category !== 'undefined' && category === 'Camping') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Camping') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Camping</span>
                    </div>
                    <div onclick="window.location.href='/?category=Farms'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Farms') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-tractor text-sm <%= (typeof category !== 'undefined' && category === 'Farms') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Farms') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Farms</span>
                    </div>
                    <div onclick="window.location.href='/?category=Arctic'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-snowflake text-sm <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Arctic</span>
                    </div>
                    <div onclick="window.location.href='/?category=Deserts'"
                        class="filter-item flex flex-row items-center gap-2 px-3 py-1.5 rounded-full border <%= (typeof category !== 'undefined' && category === 'Deserts') ? 'bg-black text-white border-black shadow-md' : 'bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:shadow-sm' %> cursor-pointer group transition-all min-w-fit">
                        <i
                            class="fas fa-sun text-sm <%= (typeof category !== 'undefined' && category === 'Deserts') ? 'text-white' : 'text-gray-500 group-hover:text-[#FF385C]' %> transition-colors"></i>
                        <span
                            class="text-xs font-medium <%= (typeof category !== 'undefined' && category === 'Deserts') ? 'text-white' : 'text-gray-600 group-hover:text-black' %>">Deserts</span>
                    </div>
                </div>
            </div>


        </div>
    </div>

    <!-- Skeleton Loading Grid (Airbnb Style) -->
    <div id="skeleton-loading" class="listings-grid pt-32" data-loading="true">
        <% for(let i=0; i<12; i++) { %>
            <div class="skeleton-card">
                <div class="skeleton skeleton-image"></div>
                <div class="card-content">
                    <div class="flex justify-between items-start">
                        <div class="skeleton skeleton-text skeleton-title"></div>
                        <div class="skeleton skeleton-text w-8 h-4 rounded"></div>
                    </div>
                    <div class="skeleton skeleton-text skeleton-subtitle"></div>
                    <div class="skeleton skeleton-text w-24 h-3 mb-1"></div>
                    <div class="skeleton skeleton-text skeleton-price"></div>
                </div>
            </div>
            <% } %>
    </div>

    <!-- Actual Listings Grid -->
    <div id="actual-listings" class="listings-grid pt-32" data-loading="true">
        <% listings.forEach((listing, index)=> {
            // Reliable Rating Text
            let ratingText = "New";
            if(listing.reviews && listing.reviews.length > 0) {
            let total = 0;
            listing.reviews.forEach(r => total += r.rating || 0);
            ratingText = (total / listing.reviews.length).toFixed(1); // "4.8"
            }
            %>
            <a href="/listings/<%= listing._id %>" class="listing-card animate-fade-in"
                style="animation-delay: <%= index * 0.05 %>s">
                <!-- Image -->
                <div class="image-container">
                    <img class="listing-image" src="<%= listing.image.url %>" alt="<%= listing.name %>">
                    <div class="image-overlay"></div>
                    <div class="favorite-btn">
                        <i class="fas fa-heart"></i>
                    </div>
                </div>

                <!-- Content (Airbnb Style) -->
                <div class="card-content">
                    <div class="listing-header">
                        <h2 class="listing-title">
                            <%= listing.location %>, <%= listing.country %>
                        </h2>
                        <div class="rating-badge">
                            <i class="fas fa-star text-black"></i>
                            <span>
                                <%= ratingText %>
                            </span>
                        </div>
                    </div>

                    <p class="listing-subtitle text-gray-500">Hosted by <%= listing.owner ? listing.owner.username
                            : 'Host' %>
                    </p>
                    <p class="listing-subtitle text-gray-500">Oct 23 - 28</p>

                    <div class="price-container mt-1">
                        <span class="price text-black">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %>
                        </span>
                        <span class="price-period"> night</span>
                    </div>
                </div>
            </a>
            <% }); %>
    </div>
    </div>

    <!-- Map Script -->
    <script>
        const listingsGeoJSON = {
            type: "FeatureCollection",
            features: <% - JSON.stringify(listings) %>
        };
    </script>
    <script src="/js/clusterMap.js"></script>

    <!-- Client-side Interactions -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Simulate loading complete or wait for images
            const skeleton = document.getElementById('skeleton-loading');
            const actual = document.getElementById('actual-listings');

            // Optional: Wait for most images to load or just a small timeout
            setTimeout(() => {
                skeleton.setAttribute('data-loading', 'false');
                actual.setAttribute('data-loading', 'false');

                // Animation
                const cards = document.querySelectorAll('.animate-fade-in');
                cards.forEach(card => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                });
            }, 800);

            // Filter Click Interaction
            const filters = document.querySelectorAll('.filter-item');
            filters.forEach(f => {
                f.addEventListener('click', () => {
                    filters.forEach(i => i.classList.remove('active'));
                    f.classList.add('active');
                });
            });

            // Favorite Toggle
            const hearts = document.querySelectorAll('.favorite-btn');
            hearts.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    btn.classList.toggle('active');
                    const icon = btn.querySelector('i');
                    icon.classList.add('fas');
                });
            });
        });
    </script>
    </body>
<% layout("./layouts/boilerplate.ejs") %>

  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 pt-6 pb-12">

    <!-- HEADER SECTION: Title & Actions -->
    <div class="mb-6">
      <h1 class="text-[26px] md:text-[32px] font-bold text-[#222222] leading-tight mb-2">
        <%= listing.name %>
      </h1>
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex flex-wrap items-center text-sm font-medium text-[#222222] gap-x-2 gap-y-1">
          <% if(listing.reviews.length> 0) { %>
            <span class="flex items-center gap-1 font-bold">
              <i class="fas fa-star text-xs"></i>
              <% let total=0; listing.reviews.forEach(r=> total += r.rating || 0);
                const avgRating = (total / listing.reviews.length).toFixed(2);
                %>
                <%= avgRating %>
            </span>
            <span>·</span>
            <button class="underline font-bold hover:text-black transition-colors">
              <%= listing.reviews.length %> reviews
            </button>
            <span>·</span>
            <% } %>
              <span class="flex items-center gap-1 underline font-bold text-[#222222]">
                <%= listing.location %>, <%= listing.country %>
              </span>
        </div>

        <div class="flex items-center gap-2">
          <!-- Wishlist Toggle -->
          <form action="/wishlist/<%= listing._id %>" method="POST" class="inline">
            <button type="submit"
              class="flex items-center gap-2 px-4 py-2 hover:bg-gray-100 rounded-lg transition-all text-sm font-semibold underline decoration-transparent hover:decoration-black">
              <i class="fas fa-heart <%= (curruser && wishlist && wishlist.includes(listing._id.toString())) ? 'text-[#FF385C]' : 'text-transparent stroke-black stroke-2' %> text-lg"
                style="<%= (curruser && wishlist && wishlist.includes(listing._id.toString())) ? '' : '-webkit-text-stroke: 1.5px black;' %>"></i>
              <%= (curruser && wishlist && wishlist.includes(listing._id.toString())) ? 'Saved' : 'Save' %>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- IMAGE HERO: Single Large Image (Premium Feel) -->
    <div class="relative w-full aspect-[4/3] md:aspect-[2/1] rounded-2xl overflow-hidden shadow-sm mb-12 bg-gray-200">
      <img src="<%= listing.image?.url || '/placeholders/listing-hero.jpg' %>" alt="<%= listing.name %>"
        class="w-full h-full object-cover hover:scale-105 transition-transform duration-700">
    </div>

    <!-- MAIN GRID: Details & Sticky Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_370px] gap-12 relative">

      <!-- LEFT COLUMN: Listing Details -->
      <div>
        <!-- Host Info -->
        <div class="flex justify-between items-center border-b border-gray-200 pb-8 mb-8">
          <div>
            <h2 class="text-[22px] font-semibold text-[#222222] mb-1">
              Entire <%= listing.type || 'home' %> hosted by <%= listing.owner?.username || 'Host' %>
            </h2>
            <ol class="flex flex-wrap gap-x-1 text-[16px] text-[#222222]">
              <li>
                <%= listing.guests || 2 %> guests
              </li>
              <span>·</span>
              <li>
                <%= listing.bedrooms || 1 %> bedroom
              </li>
              <span>·</span>
              <li>
                <%= listing.beds || 1 %> bed
              </li>
              <span>·</span>
              <li>
                <%= listing.bathrooms || 1 %> bath
              </li>
            </ol>
          </div>
          <div class="relative">
            <div class="w-14 h-14 rounded-full overflow-hidden bg-gray-100 border border-gray-200">
              <% if (listing.owner?.image) { %>
                <img src="<%= listing.owner.image %>" alt="Host" class="w-full h-full object-cover">
                <% } else { %>
                  <div class="w-full h-full flex items-center justify-center bg-black text-white font-bold text-xl">
                    <%= listing.owner?.username ? listing.owner.username[0].toUpperCase() : 'H' %>
                  </div>
                  <% } %>
            </div>
          </div>
        </div>

        <!-- Highlights / Description -->
        <div class="border-b border-gray-200 pb-8 mb-8">
          <!-- Category Highlight Example -->
          <% if(listing.category) { %>
            <div class="flex items-start gap-4 mb-6">
              <i class="fas fa-home text-2xl text-[#222222] mt-1"></i>
              <div>
                <h3 class="font-bold text-[#222222] text-base">
                  <%= listing.category %> Collection
                </h3>
                <p class="text-gray-500 text-sm">This home is part of our <%= listing.category %> collection.</p>
              </div>
            </div>
            <% } %>

              <div class="flex items-start gap-4 mb-6">
                <i class="fas fa-door-open text-2xl text-[#222222] mt-1"></i>
                <div>
                  <h3 class="font-bold text-[#222222] text-base">Self check-in</h3>
                  <p class="text-gray-500 text-sm">Check yourself in with the lockbox.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <i class="fas fa-calendar text-2xl text-[#222222] mt-1"></i>
                <div>
                  <h3 class="font-bold text-[#222222] text-base">Free cancellation for 48 hours</h3>
                </div>
              </div>
        </div>

        <!-- Listing Description -->
        <div class="border-b border-gray-200 pb-8 mb-8">
          <h2 class="text-[22px] font-semibold text-[#222222] mb-6">About this place</h2>
          <div class="text-[#222222] text-base leading-relaxed whitespace-pre-line">
            <%= listing.description %>
          </div>
        </div>

        <!-- Amenities -->
        <div class="border-b border-gray-200 pb-8 mb-8">
          <h2 class="text-[22px] font-semibold text-[#222222] mb-6">What this place offers</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-y-4">
            <% if(listing.amenities && listing.amenities.length> 0) { %>
              <% listing.amenities.forEach(am=> { %>
                <div class="flex items-center gap-4 text-[#222222]">
                  <i class="fas fa-check text-lg text-[#222222]"></i>
                  <span class="text-base font-light">
                    <%= am %>
                  </span>
                </div>
                <% }) %>
                  <% } else { %>
                    <p class="text-gray-500 italic">Amenities not specified.</p>
                    <% } %>
          </div>
        </div>

        <!-- Map View -->
        <div class="border-b border-gray-200 pb-8 mb-8">
          <h2 class="text-[22px] font-semibold text-[#222222] mb-6">Where you'll be</h2>
          <div class="h-[480px] w-full bg-gray-200 rounded-xl overflow-hidden relative">
            <div id="map" class="w-full h-full flex items-center justify-center text-gray-500 font-bold">Map loading...
            </div>
          </div>
          <div class="mt-4 font-bold text-[#222222]">
            <%= listing.location %>, <%= listing.country %>
          </div>
          <p class="text-sm text-gray-500 mt-1">Exact location provided after booking.</p>
        </div>

        <!-- Admin / Owner Controls -->
        <% if(curruser && listing.owner && curruser._id.toString()===listing.owner._id.toString()) { %>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mt-8">
            <h3 class="font-bold text-[#222222] mb-4">Owner Settings</h3>
            <div class="flex items-center gap-3">
              <a href="/listings/<%= listing._id %>/edit"
                class="bg-white border border-gray-300 text-black px-5 py-2.5 rounded-lg font-bold hover:bg-gray-100 transition-colors text-sm">Edit
                Listing</a>
              <form method="post" action="/listings/<%= listing._id %>?_method=DELETE" class="inline m-0 p-0">
                <button
                  class="bg-white border border-red-200 text-[#FF385C] px-5 py-2.5 rounded-lg font-bold hover:bg-red-50 transition-colors text-sm">Delete
                  Listing</button>
              </form>
            </div>
          </div>
          <% } %>

      </div>

      <!-- RIGHT COLUMN: Sticky Booking Card -->
      <div class="hidden lg:block">
        <div class="sticky top-28 w-full">
          <div class="border border-gray-200 rounded-xl shadow-[0_6px_16px_rgba(0,0,0,0.12)] p-6 bg-white">

            <div class="flex justify-between items-end mb-6">
              <div>
                <span class="text-2xl font-bold text-[#222222]">₹<%= listing.price.toLocaleString("en-IN") %></span>
                <span class="text-base text-[#222222]"> night</span>
              </div>
              <div class="flex items-center gap-1 text-sm font-semibold text-[#222222] underline cursor-pointer">
                <!-- Placeholder for reviews if needed or reuse logic -->
                <% if(listing.reviews.length> 0) { %>
                  <i class="fas fa-star text-xs"></i>
                  <%= (listing.reviews.reduce((a,b)=>a+(b.rating||0),0)/listing.reviews.length).toFixed(2) %>
                    <span class="text-gray-400 no-underline px-1">·</span>
                    <span class="text-gray-500">
                      <%= listing.reviews.length %> reviews
                    </span>
                    <% } else { %>
                      <span class="text-gray-500">New</span>
                      <% } %>
              </div>
            </div>

            <form action="/listings/<%= listing._id %>/checkout" method="GET">
              <div class="border border-gray-400 rounded-lg overflow-hidden mb-4">
                <div class="flex border-b border-gray-400">
                  <div class="w-1/2 p-3 border-r border-gray-400 hover:bg-gray-50 cursor-pointer relative">
                    <label class="block text-[10px] font-bold uppercase text-[#222222]">Check-in</label>
                    <input type="date" id="checkin" name="booking[checkIn]"
                      class="w-full text-sm outline-none bg-transparent cursor-pointer p-0 text-gray-600" required>
                  </div>
                  <div class="w-1/2 p-3 hover:bg-gray-50 cursor-pointer relative">
                    <label class="block text-[10px] font-bold uppercase text-[#222222]">Checkout</label>
                    <input type="date" id="checkout" name="booking[checkOut]"
                      class="w-full text-sm outline-none bg-transparent cursor-pointer p-0 text-gray-600" required>
                  </div>
                </div>
                <div class="p-3 hover:bg-gray-50 cursor-pointer relative">
                  <label class="block text-[10px] font-bold uppercase text-[#222222]">Guests</label>
                  <select name="booking[guests]"
                    class="w-full text-sm outline-none bg-transparent cursor-pointer p-0 text-gray-600">
                    <option value="1">1 guest</option>
                    <option value="2" selected>2 guests</option>
                    <option value="3">3 guests</option>
                    <option value="4">4 guests</option>
                  </select>
                </div>
              </div>

              <button
                class="w-full bg-[#FF385C] hover:bg-[#D90B3E] active:scale-[0.98] transition-all text-white font-bold py-3.5 rounded-lg text-lg mb-4 shadow-md">
                Reserve
              </button>
            </form>

            <div class="text-center text-gray-500 text-sm mb-6">You won't be charged yet</div>

            <div class="space-y-4 text-[#222222] text-base">
              <div class="flex justify-between">
                <span class="underline">₹<span id="base-price">
                    <%= listing.price.toLocaleString("en-IN") %>
                  </span> x <span id="total-nights">5</span> nights</span>
                <span>₹<span id="base-cost">
                    <%= (listing.price * 5).toLocaleString("en-IN") %>
                  </span></span>
              </div>
              <div class="flex justify-between">
                <span class="underline">Cleaning fee</span>
                <span>₹2,500</span>
              </div>
              <div class="flex justify-between">
                <span class="underline">Airbnb service fee</span>
                <span>₹<span id="service-fee">8,450</span></span>
              </div>
            </div>

            <div class="my-6 border-t border-gray-200"></div>

            <div class="flex justify-between font-bold text-lg text-[#222222]">
              <span>Total</span>
              <span>₹<span id="grand-total">
                  <%= (listing.price * 5 + 2500 + 8450).toLocaleString("en-IN") %>
                </span></span>
            </div>

          </div>

          <!-- Rare Find Badge (Optional Decorative) -->
          <div class="mt-6 flex items-center justify-center gap-3 border border-gray-200 rounded-xl p-4 bg-white/50">
            <div class="text-[#FF385C]"><i class="fas fa-diamond text-2xl"></i></div>
            <div class="text-sm">
              <span class="font-bold text-[#222222]">This is a rare find.</span>
              <span class="text-gray-500 block">
                <%= listing.owner?.username || 'Host' %>'s place is usually booked.
              </span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- REVIEWS SECTION -->
    <div class="border-t border-gray-200 pt-12 pb-12 mt-12">
      <h2 class="text-2xl font-bold text-[#222222] mb-8 flex items-center gap-2">
        <% if(listing.reviews.length> 0) { %>
          <i class="fas fa-star text-[#FF385C]"></i>
          <% let total=0; listing.reviews.forEach(r=> total += r.rating || 0);
            const avgRating = (total / listing.reviews.length).toFixed(2);
            %>
            <%= avgRating %> · <%= listing.reviews.length %> reviews
                <% } else { %>
                  No reviews yet
                  <% } %>
      </h2>

      <% if(listing.reviews.length> 0) { %>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <% listing.reviews.forEach(review=> { %>
            <div
              class="border border-gray-200 rounded-xl p-3 bg-white shadow-sm flex flex-col gap-2 h-full hover:shadow-md transition-shadow">
              <div class="flex justify-between items-start mb-1">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full overflow-hidden bg-gray-100 flex-shrink-0">
                    <img src="https://api.dicebear.com/7.x/initials/svg?seed=<%= review.author?.username || 'User' %>"
                      alt="User" class="w-full h-full object-cover">
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-bold text-[#222222] text-xs truncate">
                      <%= review.author?.username || 'Guest' %>
                    </h3>
                    <p class="text-[10px] text-gray-500">
                      <%= new Date(review.createdAt).toLocaleDateString(undefined, { month: 'short' , year: '2-digit' })
                        %>
                    </p>
                  </div>
                </div>
                <% if(review.rating) { %>
                  <div class="flex items-center gap-1 bg-gray-50 px-1.5 py-0.5 rounded-md border border-gray-100">
                    <span class="font-bold text-xs text-[#222222]">
                      <%= review.rating %>
                    </span>
                    <i class="fas fa-star text-xs text-[#FF385C]"></i>
                  </div>
                  <% } %>
              </div>
              <div class="text-[#222222] text-xs leading-relaxed line-clamp-3">
                <%= review.comment %>
              </div>
              <% if(curruser && review.author && curruser._id.toString()===review.author._id.toString()) { %>
                <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                  class="mt-auto pt-1">
                  <button
                    class="text-[10px] font-bold text-gray-400 hover:text-red-500 transition-colors">Delete</button>
                </form>
                <% } %>
            </div>
            <% }) %>
        </div>
        <% } %>

          <% if(curruser) { %>
            <!-- Premium Inline Review Form -->
            <div class="mt-10 bg-white border border-gray-200 rounded-xl p-8 shadow-sm">
              <h3 class="text-xl font-bold text-[#222222] mb-6">Leave a Review</h3>
              <form method="post" action="/listings/<%= listing._id %>/reviews" class="space-y-6">
                <!-- Rating -->
                <div>
                  <label class="block text-sm font-bold text-gray-700 mb-2">Rating</label>
                  <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                      aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" checked />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>

                <!-- Comment -->
                <div>
                  <label for="comment" class="block text-sm font-bold text-gray-900 mb-2">Comment</label>
                  <textarea name="review[comment]" id="comment" rows="4"
                    class="block w-full rounded-xl border-gray-300 shadow-sm focus:border-black focus:ring-black sm:text-sm border p-4 resize-none bg-gray-50 focus:bg-white transition-colors"
                    placeholder="Share your experience with other travelers..." required></textarea>
                </div>

                <button
                  class="bg-[#FF385C] hover:bg-[#D90B3E] text-white font-bold px-8 py-3.5 rounded-lg text-lg shadow-md transition-all active:scale-[0.98]">
                  Submit Review
                </button>
              </form>
            </div>
            <% } else { %>
              <div class="mt-10 p-6 bg-gray-50 rounded-xl border border-gray-100">
                <p class="text-[#222222]">Please <a href="/login" class="underline font-bold">login</a> to leave a
                  review.</p>
              </div>
              <% } %>

    </div>

  </div>

  <!-- Scripts for Map -->
  <script>
    const rawCoords = <%- JSON.stringify(listing.geometry?.coordinates || [77.209, 28.6139]) %>;
    const mapToken = <%- JSON.stringify(mapToken) %>;
    const listingLocation = <%- JSON.stringify(listing.location) %>;

    console.log("Map Debug: Token exists?", !!mapToken);
    console.log("Map Debug: Coordinates", rawCoords);

    window.showMapData = {
      mapToken: mapToken,
      coordinates: rawCoords,
      listingLocation: listingLocation
    };
  </script>
  <script src="/js/map.js"></script>

  <!-- Scripts for Booking -->
  <script>
    window.listingData = {
      price: <% - listing.price %>,
      serviceFee: 8450, // Default or calculated
      cleaningFee: 2500
    };
  </script>
  <script src="/js/booking.js"></script>
<% layout("./layouts/boilerplate.ejs") %>

  <body class="flex flex-col min-h-screen" ">
    <div class=" flex-grow">

edesign listing layout to match modern Airbnb aesthetic with improved grid and card styling.
    <section
      class="hero relative z-40 h-screen text-white rounded-lg mt-20 flex flex-col justify-center items-center overflow-hidden">
      <div class="absolute inset-0 w-full h-full bg-cover bg-center animate-zoomSlow"
        style="background-image: url('https://images.unsplash.com/photo-1666307599559-4d3f50527ecb?q=80&w=2787&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'); filter: brightness(0.5); z-index: -1;">
      </div>
      <h1 class="text-5xl font-bold mb-4 fade-in">
        <span id="typed-text"
          class="border-r-2 border-white pr-2 text-white font-bold drop-shadow-[2px_2px_2px_rgba(0,0,0,0.7)]"></span>
      </h1>
      <p class="text-white font-semibold border-r-2 mb-8 fade-in">Explore our curated collection of premium
        accommodations </p>
      <a href="/listings"
        class="bg-white text-gray-800 py-2 px-4 rounded-lg hover:bg-gray-100 transition duration-300 fade-in hover:border-2 hover:border-white">Explore
        Listings</a>
    </section>

    <section class="featured-destinations py-20 px-8">
      <h2 class="text-3xl text-center font-bold mb-12 font-[Outfit]">Top Rated Listings</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
        <% topListings.forEach(listing=> {
          let totalRating = 0;
          listing.reviews.forEach(r => totalRating += r.rating || 0);
          const avgRating = listing.reviews.length ? (totalRating / listing.reviews.length).toFixed(1) : "New";
          %>
          <div
            class="group bg-white rounded-2xl overflow-hidden hover:transform hover:-translate-y-2 transition-all duration-500 shadow-[0_4px_20px_rgba(0,0,0,0.05)] hover:shadow-[0_12px_40px_rgba(0,0,0,0.1)] border border-gray-100">
            <a href="/listings/<%= listing._id %>" class="block relative aspect-[4/3] overflow-hidden">
              <img src="<%= listing.image.url %>" alt="<%= listing.name %>"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
              <div
                class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-2 py-1 rounded-lg flex items-center gap-1 text-xs font-bold shadow-sm">
                <i class="fas fa-star text-yellow-400"></i>
                <%= avgRating %>
              </div>
            </a>
            <div class="p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-1 font-[Outfit] truncate">
                <%= listing.name %>
              </h3>
              <p class="text-gray-500 text-sm mb-4">
                <%= listing.location %>
              </p>
              <div class="flex items-center justify-between">
                <span class="text-lg font-bold text-[#FF385C]">₹<%= listing.price.toLocaleString("en-IN") %> <span
                      class="text-xs text-gray-500 font-normal">/ night</span></span>
                <a href="/listings/<%= listing._id %>"
                  class="text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-[#FF385C] transition-colors">Details</a>
              </div>
            </div>
          </div>
          <% }) %>
      </div>
    </section>

    <section class="unique-stays py-20 bg-gray-50/50">
      <h2 class="text-3xl text-center font-bold mb-12 font-[Outfit]">Unique Stays for Every Occasion</h2>
      <div class="flex overflow-x-auto px-8 pb-8 gap-6 scrollbar-hide">
        <% randomListings.forEach(listing=> { %>
          <div
            class="flex-none w-72 group bg-white p-3 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-500 border border-white hover:border-gray-100">
            <a href="/listings/<%= listing._id %>" class="block aspect-square rounded-xl overflow-hidden mb-4">
              <img src="<%= listing.image.url %>" alt="<%= listing.name %>"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
            </a>
            <h3 class="text-md font-bold text-gray-800 px-2 truncate font-[Outfit]">
              <%= listing.name %>
            </h3>
            <p class="text-xs text-gray-500 px-2 mt-1">₹<%= listing.price.toLocaleString("en-IN") %> night</p>
          </div>
          <% }) %>
      </div>
    </section>

    <section class="become-host py-20 bg-gradient-to-r from-blue-50 to-purple-100">
      <div class="container mx-auto px-4 flex flex-col lg:flex-row items-center space-y-8 lg:space-y-0 lg:space-x-12">
        <img
          src="https://images.unsplash.com/photo-1506277886164-e25aa3f4ef7f?q=80&w=2835&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt="Happy Host"
          class="w-full lg:w-1/2 rounded-xl shadow-xl hover:scale-105 transition-transform duration-300">

        <div class="lg:w-1/2 text-center lg:text-left">
          <h2 class="text-4xl font-bold text-gray-800 mb-4">Become a Host</h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">Share your space and start earning today. Join a
            community of hosts offering unique stays and unforgettable experiences around the world.</p>
          <a href="/listings/new"
            class="inline-block bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white font-semibold px-6 py-3 rounded-lg shadow-md transition duration-300">
            Get Started
          </a>
        </div>
      </div>
    </section>

    <section class="testimonials py-24 bg-white">
      <h2 class="text-3xl text-center font-bold mb-16 font-[Outfit]">Hear From Our Guests</h2>
      <div class="flex overflow-x-auto px-8 pb-12 gap-8 scrollbar-hide">
        <% guestReviews.forEach(review=> { %>
          <div
            class="flex-none w-80 bg-gray-50/50 p-8 rounded-3xl border border-gray-100 hover:bg-white hover:shadow-xl transition-all duration-500 group">
            <div class="flex gap-1 mb-6">
              <% for (let i=1; i <=5; i++) { %>
                <i class="fas fa-star text-sm <%= i <= review.rating ? 'text-yellow-400' : 'text-gray-200' %>"></i>
                <% } %>
            </div>
            <p class="text-gray-700 leading-relaxed mb-8 italic">"<%= review.comment %>"</p>
            <div class="flex items-center gap-4">
              <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=<%= review.author?.username || 'guest' %>"
                alt="Avatar"
                class="w-12 h-12 rounded-full ring-2 ring-white shadow-sm transition-transform duration-500 group-hover:scale-110">
              <div>
                <span class="block font-bold text-gray-900 font-[Outfit]">@<%= review.author?.username || 'Guest' %>
                    </span>
                <span class="text-xs text-gray-400 uppercase tracking-widest">Verified Guest</span>
              </div>
            </div>
          </div>
          <% }) %>
      </div>
    </section>


    <section class="explore-experiences py-16">
      <h2 class="text-3xl text-center font-bold mb-8">Explore Experiences</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 px-4">
        <% experiences.forEach(experience=> { %>
          <div class="experience bg-white p-4 rounded-lg shadow-md hover:shadow-xl transition duration-300">
            <img src="<%= experience.image %>" alt="<%= experience.title %>"
              class="rounded-lg h-64 w-full object-cover">
            <h3 class="text-xl font-semibold mt-4">
              <%= experience.title %>
            </h3>
            <p class="text-gray-600">
              <%= experience.description %>
            </p>
          </div>
          <% }) %>
      </div>
    </section>

    <section class="newsletter py-16 bg-gray-100">
      <h2 class="text-3xl text-center font-bold mb-4">Stay in the Know</h2>
      <p class="text-center text-gray-600 mb-8">Subscribe to our newsletter for travel tips, offers, and inspiration.
      </p>
      <form class="flex justify-center">
        <input type="email" placeholder="Your Email" class="p-2 rounded-l-md">
        <button class="bg-blue-500 text-white p-2 rounded-r-md">Subscribe</button>
      </form>
    </section>

    </div>
    <script>
      const phrases = [
        "Find Your Perfect Stay",
        "Unforgettable Getaways Await",
        "Discover Unique Homes Around the World"
      ];

      let index = 0;
      let charIndex = 0;
      const typedText = document.getElementById("typed-text");

      function typePhrase() {
        if (charIndex <= phrases[index].length) {
          typedText.innerText = phrases[index].substring(0, charIndex++);
          setTimeout(typePhrase, 100);
        } else {
          setTimeout(erasePhrase, 2000);
        }
      }

      function erasePhrase() {
        if (charIndex >= 0) {
          typedText.innerText = phrases[index].substring(0, charIndex--);
          setTimeout(erasePhrase, 50);
        } else {
          index = (index + 1) % phrases.length;
          setTimeout(typePhrase, 500);
        }
      }

      document.addEventListener("DOMContentLoaded", typePhrase);
    </script>
    <style>
      @keyframes zoomSlow {
        0% {
          transform: scale(1);
        }

        100% {
          transform: scale(1.2);
        }
      }

      .animate-zoomSlow {
        animation: zoomSlow 10s ease-in-out infinite alternate;
      }
    </style>
  </body>
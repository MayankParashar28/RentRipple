<% layout("./layouts/boilerplate.ejs") %>

    <body>
        <div class="listings-container">
            <div class="listing-card p-8 max-w-3xl mx-auto mt-10">

                <div class="text-center mb-8">
                    <h1 class="section-title text-3xl">Edit Listing</h1>
                    <p class="section-subtitle">Update your property details</p>
                </div>

                <form method="post" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data">

                    <div class="mb-4">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" name="listing[name]" id="name" value="<%= listing.name %>" required
                            class="form-control input-glass">
                    </div>

                    <div class="mb-4">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" id="description" rows="4"
                            class="form-control input-glass"><%= listing.description %></textarea>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label for="price" class="form-label">Price</label>
                            <input type="number" name="listing[price]" id="price" value="<%= listing.price %>"
                                class="form-control input-glass">
                        </div>
                        <div>
                            <label for="country" class="form-label">Country</label>
                            <input type="text" name="listing[country]" id="country" value="<%= listing.country %>"
                                class="form-control input-glass">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="listing[location]" id="location" value="<%= listing.location %>"
                            class="form-control input-glass">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="form-label mb-2">Current Image</label>
                            <div class="image-container rounded-lg h-40">
                                <img src="<%=listing.image.url %>" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div>
                            <label for="image" class="form-label">Upload New Image</label>
                            <input type="file" name="listing[image]" id="image"
                                class="form-control input-glass h-full pt-10">
                        </div>
                    </div>

                    <div class="text-center mt-8">
                        <button class="btn-gradient w-full md:w-1/2 text-lg" type="submit">Update Listing</button>
                    </div>

                </form>
            </div>
        </div>
    </body>
<% layout("./layouts/boilerplate.ejs") %>

  <body>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 font-[Outfit]">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-start">

        <!-- LEFT COLUMN: Sticky Branding -->
        <div class="hidden lg:block sticky top-28">
          <div class="relative rounded-[2rem] overflow-hidden aspect-[4/5] shadow-2xl group">
            <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=2069&auto=format&fit=crop"
              alt="Host with RentRipple"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

            <div class="absolute bottom-0 left-0 p-10 text-white">
              <div
                class="mb-4 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/20 text-xs font-bold uppercase tracking-wider">
                <i class="fas fa-magic"></i> Host Magic
              </div>
              <h3 class="text-4xl font-extrabold mb-4 leading-tight">Design your<br>masterpiece.</h3>
              <p class="text-white/80 text-lg">"Details allow us to create unique experiences for every guest."</p>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Form -->
        <div class="w-full py-2">

          <div class="mb-12">
            <h1 class="text-4xl font-extrabold text-[#222222] mb-3">New Listing</h1>
            <p class="text-gray-500 text-lg">Fill out the template below to publish.</p>
          </div>

          <form action="/listings" method="post" class="needs-validation space-y-8" novalidate
            enctype="multipart/form-data">

            <!-- Title (Floating Label) -->
            <div class="relative">
              <input type="text" name="listing[name]" id="name" placeholder="e.g. Modern Sunset Villa" required
                class="block w-full px-5 pt-6 pb-2 text-lg font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
              <label for="name"
                class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-focus:dark:text-blue-500 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                Listing Title
              </label>
            </div>

            <!-- Description (Floating Label) -->
            <div class="relative">
              <textarea name="listing[description]" id="description" rows="5" placeholder="Describe your place..."
                required
                class="block w-full px-5 pt-6 pb-2 text-base font-medium text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all resize-none"></textarea>
              <label for="description"
                class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                Description
              </label>
            </div>

            <!-- Price & Location Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

              <!-- Location -->
              <div class="md:col-span-2 relative">
                <input type="text" name="listing[location]" id="location" placeholder="e.g. 123 Main St, Goa" required
                  class="block w-full pl-12 pr-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                <i
                  class="fas fa-map-marker-alt absolute left-5 top-5 text-gray-400 peer-focus:text-black transition-colors"></i>
                <label for="location"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-12 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Full Address
                </label>
              </div>

              <!-- Price -->
              <div class="relative">
                <input type="number" name="listing[price]" id="price" placeholder="5000" required
                  class="block w-full pl-8 pr-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                <span class="absolute left-5 top-5 font-bold text-gray-400 peer-focus:text-black">₹</span>
                <label for="price"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-8 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Price / Night
                </label>
              </div>

              <!-- Country -->
              <div class="relative">
                <input type="text" name="listing[country]" id="country" placeholder="India" required
                  class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                <label for="country"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Country
                </label>
              </div>
            </div>

            <hr class="border-gray-100">

            <!-- Image Upload (Template Style) -->
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Cover Photo</label>
              <div class="relative group">
                <input type="file" name="listing[image]" id="image"
                  class="peer absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" required
                  onchange="previewImage(this)">

                <div
                  class="w-full aspect-video rounded-2xl bg-gray-50 border-2 border-dashed border-gray-300 peer-focus:border-black peer-focus:bg-white flex flex-col items-center justify-center transition-all group-hover:bg-gray-100"
                  id="upload-placeholder">
                  <div class="w-12 h-12 rounded-full bg-white shadow-sm flex items-center justify-center mb-2">
                    <i class="fas fa-cloud-upload-alt text-xl text-[#FF385C]"></i>
                  </div>
                  <p class="text-sm font-bold text-gray-900">Upload Media</p>
                </div>
                <img id="image-preview" src="#"
                  class="hidden absolute inset-0 w-full h-full object-cover rounded-2xl z-10 pointer-events-none">
              </div>
            </div>

            <hr class="border-gray-100">

            <!-- Details & Amenities -->
            <div class="grid grid-cols-2 gap-4">
              <!-- Type -->
              <div class="relative">
                <select name="listing[type]" id="type"
                  class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white peer transition-all cursor-pointer">
                  <option value="" disabled selected>Select Property Type</option>
                  <option value="Apartment">Apartment</option>
                  <option value="House">House</option>
                  <option value="Villa">Villa</option>
                  <option value="Resort">Resort</option>
                </select>
                <label for="type"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Property Type
                </label>
                <i class="fas fa-chevron-down absolute right-5 top-6 text-gray-400 pointer-events-none"></i>
              </div>

              <!-- Category -->
              <div class="relative">
                <select name="listing[category]" id="category"
                  class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white peer transition-all cursor-pointer"
                  required>
                  <option value="" disabled selected>Select Category</option>
                  <option value="Beach">Beach</option>
                  <option value="Mountains">Mountains</option>
                  <option value="Cities">Cities</option>
                  <option value="Castles">Castles</option>
                  <option value="Pools">Pools</option>
                  <option value="Camping">Camping</option>
                  <option value="Farms">Farms</option>
                  <option value="Arctic">Arctic</option>
                  <option value="Deserts">Deserts</option>
                </select>
                <label for="category"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Category
                </label>
                <i class="fas fa-chevron-down absolute right-5 top-6 text-gray-400 pointer-events-none"></i>
              </div>

              <!-- Guests -->
              <div class="relative">
                <input type="number" name="listing[guests]" id="guests" placeholder="2" value="2" min="1"
                  class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                <label for="guests"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Guests
                </label>
              </div>

              <!-- Bedrooms -->
              <div class="relative">
                <input type="number" name="listing[bedrooms]" id="bedrooms" placeholder="1" value="1" min="0"
                  class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                <label for="bedrooms"
                  class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                  Bedrooms
                </label>
              </div>
            </div>

            <div>
              <label class="block text-sm font-bold text-gray-700 mb-4 uppercase tracking-wide">Amenities</label>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <% const amenities=['WiFi', 'Parking' , 'AC' , 'Kitchen' , 'Pool' , 'TV' , 'Gym' , 'Pet Friendly' ]; %>
                  <% amenities.forEach(am=> { %>
                    <label class="cursor-pointer relative">
                      <input type="checkbox" name="listing[amenities][]" value="<%= am %>" class="peer sr-only">
                      <div
                        class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-500 font-bold text-sm text-center
                                    peer-checked:bg-black peer-checked:text-white peer-checked:border-black 
                                    hover:bg-gray-50 transition-all select-none shadow-sm peer-focus:ring-2 peer-focus:ring-black peer-focus:ring-offset-1">
                        <%= am %>
                      </div>
                    </label>
                    <% }); %>
              </div>
            </div>

            <hr class="border-gray-100">

            <!-- House Rules & Policies -->
            <div>
              <h3 class="text-sm font-bold text-gray-700 mb-4 uppercase tracking-wide">House Rules & Policies</h3>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Rules Textarea -->
                <div class="md:col-span-2 relative">
                  <textarea name="listing[rules]" id="rules" rows="4" placeholder="e.g. No smoking, No pets"
                    class="block w-full px-5 pt-6 pb-2 text-base font-medium text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all resize-none"></textarea>
                  <label for="rules"
                    class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                    House Rules (e.g. No smoking, No pets)
                  </label>
                </div>

                <!-- Check-in Time -->
                <div class="relative">
                  <input type="text" name="listing[checkin]" id="checkin" placeholder="14:00"
                    class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                  <label for="checkin"
                    class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                    Check-in Time (e.g. 14:00)
                  </label>
                </div>

                <!-- Check-out Time -->
                <div class="relative">
                  <input type="text" name="listing[checkout]" id="checkout" placeholder="11:00"
                    class="block w-full px-5 pt-6 pb-2 text-base font-bold text-gray-900 bg-gray-50 border border-gray-200 rounded-xl appearance-none focus:outline-none focus:ring-0 focus:border-black focus:bg-white placeholder:text-transparent focus:placeholder:text-gray-400 peer transition-all" />
                  <label for="checkout"
                    class="absolute text-sm font-bold text-gray-500 duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-5 peer-focus:text-black peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3">
                    Check-out Time (e.g. 11:00)
                  </label>
                </div>
              </div>
            </div>

            <!-- Submit -->
            <div class="pt-6">
              <button type="submit"
                class="w-full bg-[#FF385C] hover:bg-[#D41245] text-white font-extrabold py-5 rounded-xl text-xl shadow-lg hover:shadow-xl transition-all hover:-translate-y-1">
                Publish Listing
              </button>
              <a href="/listings"
                class="block text-center mt-5 font-bold text-sm text-gray-400 hover:text-gray-600 transition-colors">Cancel</a>
            </div>

          </form>
        </div>
      </div>
    </div>

    <script>
      function previewImage(input) {
        if (input.files && input.files[0]) {
          const reader = new FileReader();
          reader.onload = function (e) {
            const preview = document.getElementById('image-preview');
            const placeholder = document.getElementById('upload-placeholder');
            preview.src = e.target.result;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden'); // Hide placeholder but keep size
          }
          reader.readAsDataURL(input.files[0]);
        }
      }
    </script>

    <script>
      (() => {
        'use strict'
        const forms = document.querySelectorAll('.needs-validation')
        Array.from(forms).forEach(form => {
          form.addEventListener('submit', event => {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }
            form.classList.add('was-validated')
          }, false)
        })
      })()

      const locationInput = document.getElementById('location');
      const form = document.querySelector('form');

      form.addEventListener('submit', async (e) => {
        if (!form.checkValidity()) return;
        e.preventDefault();
        const location = locationInput.value;
        const MAPBOX_TOKEN = '<%= mapToken %>';

        // UI Feedback is handled by browser validation or post-submit load
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        submitBtn.disabled = true;

        try {
          const res = await fetch(`https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(location)}.json?access_token=${MAPBOX_TOKEN}`);
          const data = await res.json();
          if (data.features && data.features.length > 0) {
            const [lng, lat] = data.features[0].geometry.coordinates;
            const lngInput = document.createElement('input');
            lngInput.type = 'hidden';
            lngInput.name = 'listing[geometry][coordinates][]';
            lngInput.value = lng;
            const latInput = document.createElement('input');
            latInput.type = 'hidden';
            latInput.name = 'listing[geometry][coordinates][]';
            latInput.value = lat;
            form.appendChild(lngInput);
            form.appendChild(latInput);
          }
          form.submit();
        } catch (err) {
          console.error(err);
          form.submit();
        }
      });
    </script>
  </body>